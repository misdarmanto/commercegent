# Used by docker-compose.yml only (variable substitution for ports, the
# MySQL root password/database name, and the dashboard's build-time VITE_*
# vars). App secrets still live in apps/api/.env — copy that from
# apps/api/.env.example separately; docker-compose loads it via env_file
# and only overrides DB_HOST/REDIS_HOST so the api container reaches the
# other containers instead of localhost.
#
# Usage: cp .env.example .env

# --- Ports exposed on the host ---
DB_PORT=3306
REDIS_PORT=6379
API_PORT=8000
DASHBOARD_PORT=5173

# --- MySQL ---
DB_PASSWORD=root
DB_NAME=fresh_ecommerce

# --- Dashboard build-time vars (baked into the static bundle at build time) ---
VITE_APP_STAGE=production
VITE_BASE_URL=http://localhost:8000
VITE_LOCAL_STORAGE_KEY=fresh_dashboard_token
VITE_UPLOAD_FILE_URL=
VITE_TOKEN_KEY_LOCAL_STORAGE=fresh_dashboard_token
VITE_TOKEN_SECRET=
