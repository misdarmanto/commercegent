{
  "name": "fresh-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "FRESH Ecommerce monorepo - backend API and admin dashboard.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@fresh-ecommerce/api",
    "dev:dashboard": "turbo run dev --filter=@fresh-ecommerce/dashboard",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "turbo": "^2.0.0"
  },
  "lint-staged": {
    "apps/api/**/*.{ts,js}": [
      "sh -c 'cd apps/api && npx eslint --fix'"
    ],
    "apps/dashboard/**/*.{ts,tsx}": [
      "sh -c 'cd apps/dashboard && npx eslint --fix'"
    ]
  }
}
