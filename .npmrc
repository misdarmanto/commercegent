engine-strict=true

# apps/dashboard is on React 18 and apps/storefront is on React 19. Without
# this, pnpm hoists a single @types/react(-dom) to the workspace root
# node_modules, and which version wins is non-deterministic between a fresh
# CI install and an incrementally-updated local one — causing a spurious tsc
# error ("ReactNode is not assignable to ReactNode") in whichever app didn't
# get its own version hoisted. Each app's own node_modules/@types/react
# already resolves correctly on its own (pnpm's per-package linking); this
# only stops the root-level hoist from shadowing that with the wrong one.
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom

# Note: this alone does NOT fully fix the "ReactNode is not assignable to
# ReactNode" cross-version type error react-i18next's own .d.ts can trigger
# (verified: passed on three from-scratch macOS installs, still failed the
# same way on GitHub Actions' Ubuntu runner — pnpm's peer-resolution
# mechanism has an inner shared node_modules that `hoist=false` doesn't
# remove either). The real fix for that is in
# apps/storefront/src/i18n/I18nProvider.tsx, which re-types
# I18nextProvider locally instead of trusting react-i18next's bundled
# types. This hoist exclusion is kept as a reasonable general hygiene
# measure, not as the fix for that specific error.
