engine-strict=true

# apps/dashboard is on React 18 and apps/storefront is on React 19. Without
# this, pnpm hoists a single @types/react(-dom) to the workspace root
# node_modules, and which version wins is non-deterministic between a fresh
# CI install and an incrementally-updated local one — causing a spurious tsc
# error ("ReactNode is not assignable to ReactNode") in whichever app didn't
# get its own version hoisted. Each app's own node_modules/@types/react
# already resolves correctly on its own (pnpm's per-package linking); this
# only stops the root-level hoist from shadowing that with the wrong one.
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom
