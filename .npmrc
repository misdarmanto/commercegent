engine-strict=true

# apps/dashboard is on React 18 and apps/storefront is on React 19; without
# this, pnpm hoists a single @types/react(-dom) to the workspace root and
# whichever version wins is non-deterministic between a fresh CI install and
# an incrementally-updated local one, causing spurious tsc errors like
# "ReactNode is not assignable to ReactNode" in only one of the two apps.
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom
