engine-strict=true

# apps/dashboard is on React 18 and apps/storefront is on React 19. Without
# this, pnpm hoists a single @types/react(-dom) to the workspace root
# node_modules, and which version wins is non-deterministic between a fresh
# CI install and an incrementally-updated local one — causing a spurious tsc
# error ("ReactNode is not assignable to ReactNode") in whichever app didn't
# get its own version hoisted. Each app's own node_modules/@types/react
# already resolves correctly on its own (pnpm's per-package linking); this
# only stops the root-level hoist from shadowing that with the wrong one.
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom

# The exclusion above only stops @types/react(-dom) from being hoisted to
# the workspace root; it doesn't touch pnpm's shared inner "virtual store"
# node_modules used to resolve phantom/nested deps, which a package like
# react-i18next can still walk up into when TypeScript resolves its own
# `import type { ReactNode } from 'react'`. Disabling that inner hoist
# entirely forces every package to resolve strictly through its own
# dependency graph, matching how CI (Linux) actually behaves — verified
# because the public-hoist-pattern-only fix above passed locally on macOS
# but still failed the exact same way on GitHub Actions' Ubuntu runner.
hoist=false
